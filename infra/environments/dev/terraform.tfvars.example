# To import a reviewed existing email channel, set provisioning_mode to
# ADOPT_EXISTING and also provide its exact projects/.../notificationChannels/...
# name, verification evidence and this acknowledgement:
# acknowledgement = "I_ACKNOWLEDGE_TERRAFORM_WILL_IMPORT_AND_MANAGE_THIS_VERIFIED_EMAIL_CHANNEL"
