kubeconfig_path                 = "~/.kube/config"
namespace                       = "ai-native-content-agency"
image_repository                = "ai-native-content-agency"
image_tag                       = "local"
replica_count                   = 1
storage_backend                 = "sqlite"
persistence_enabled             = true
prometheus_rule_enabled          = false
# For a shared deployment set storage_backend="postgresql", replica_count>=2,
# persistence_enabled=false, and reference a pre-provisioned URL Secret:
postgresql_existing_secret      = ""
postgresql_database_url_key     = "database-url"
postgresql_pool_min_size        = 1
postgresql_pool_max_size        = 10
postgresql_connect_timeout_seconds = 15
postgresql_schema_mode          = "validate"
runtime_auth_existing_secret    = "ai-native-content-agency-runtime"
runtime_auth_tenant_api_keys_key = "tenant-api-keys.json"
runtime_auth_identity_credentials_key = "identity-credentials.json"
login_max_failures              = 5
login_source_max_failures       = 50
login_window_seconds                     = 300
authenticated_request_max_per_principal = 600
authenticated_request_max_per_tenant    = 6000
authenticated_request_window_seconds    = 60
forwarded_allow_ips                      = "127.0.0.1"
session_cookie_secure           = true
helm_wait                       = true
helm_timeout_seconds            = 300

# Public media delivery is optional and references a pre-provisioned Secret only.
public_media_base_url                 = ""
public_media_ttl_seconds              = 86400
public_media_existing_secret          = ""
public_media_signing_keys_json_key    = "public-media-signing-keys.json"
public_media_active_signing_key_id_key = "public-media-active-signing-key-id"
public_media_legacy_signing_key_key   = ""

# Model execution and durable economic authority stay disabled until explicitly authorized.
model_execution_enabled        = false
model_effect_authority_enabled = false
model_provider                 = ""
model_egress_allowed_hosts     = ""
model_existing_secret          = ""

# External social publication stays disabled until explicitly authorized.
political_content_enabled     = false
social_publication_enabled    = false
political_publication_enabled = false
political_paid_media_enabled  = false
