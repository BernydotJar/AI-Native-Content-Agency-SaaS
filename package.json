{
  "name": "ai-native-content-agency-saas",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify:accessibility-browser": "node scripts/verify-accessibility-browser.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "start:local": "./scripts/run-local-product.sh",
    "validate:program": "python3 scripts/validate-program-state.py",
    "validate:compliance": "python3 scripts/verify-release-compliance.py",
    "validate:operability": "python3 scripts/verify-operability.py",
    "verify:social-browser": "node scripts/verify-social-output-browser.mjs",
    "generate:social-key": "python3 scripts/generate-social-encryption-key.py --env-file .env.local",
    "verify:social-oauth-browser": "node scripts/verify-social-oauth-browser.mjs",
    "verify:async-run-browser": "node scripts/verify-async-run-browser.mjs",
    "verify:social-publication-browser": "node scripts/verify-social-publication-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.6"
  }
}
