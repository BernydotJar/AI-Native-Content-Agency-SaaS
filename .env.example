# Copy to .env.local. Never commit real values.

# Optional model provider configuration.
DEEPSEEK_API_KEY=
AGENCY_DEEPSEEK_MODEL=deepseek-v4-flash

# X application credentials and exact OAuth callback.
AGENCY_X_CONSUMER_KEY=
AGENCY_X_CONSUMER_SECRET=
AGENCY_X_REDIRECT_URI=http://127.0.0.1:4175/api/v1/social-channels/x/oauth/callback

# Instagram application credentials and exact OAuth callback.
AGENCY_INSTAGRAM_APP_ID=
AGENCY_INSTAGRAM_APP_SECRET=
AGENCY_INSTAGRAM_REDIRECT_URI=http://127.0.0.1:4175/api/v1/social-channels/instagram/oauth/callback

# Added by the OAuth implementation slice. Generate locally; do not commit.
AGENCY_SOCIAL_TOKEN_ENCRYPTION_KEYS_JSON=
AGENCY_SOCIAL_TOKEN_ACTIVE_KEY_ID=
