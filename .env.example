# Copy to .env.local. Never commit real values.

# Optional model provider configuration. Both switches remain false by default.
AGENCY_MODEL_EXECUTION_ENABLED=false
AGENCY_MODEL_EFFECT_AUTHORITY_ENABLED=false
AGENCY_MODEL_PROVIDER=
AGENCY_MODEL_EGRESS_ALLOWED_HOSTS=
DEEPSEEK_API_KEY=
AGENCY_DEEPSEEK_MODEL=deepseek-v4-flash

# Browser sessions use SameSite=Lax so X/Instagram can return through a top-level OAuth GET.
# The local runner enables Secure automatically when either callback is HTTPS.
AGENCY_SESSION_COOKIE_SAMESITE=lax

# X application credentials and exact OAuth callback.
AGENCY_X_CONSUMER_KEY=
AGENCY_X_CONSUMER_SECRET=
AGENCY_X_REDIRECT_URI=http://127.0.0.1:4175/api/v1/social-channels/x/oauth/callback

# Instagram application credentials and exact OAuth callback.
AGENCY_INSTAGRAM_APP_ID=
AGENCY_INSTAGRAM_APP_SECRET=
AGENCY_INSTAGRAM_REDIRECT_URI=http://127.0.0.1:4175/api/v1/social-channels/instagram/oauth/callback
AGENCY_INSTAGRAM_GRAPH_API_VERSION=v24.0

# Added by the OAuth implementation slice. Generate locally; do not commit.
AGENCY_SOCIAL_TOKEN_ENCRYPTION_KEYS_JSON=
AGENCY_SOCIAL_TOKEN_ACTIVE_KEY_ID=
AGENCY_POLITICAL_CONTENT_ENABLED=false
AGENCY_SOCIAL_PUBLICATION_ENABLED=false
AGENCY_POLITICAL_PUBLICATION_ENABLED=false
AGENCY_POLITICAL_PAID_MEDIA_ENABLED=false
AGENCY_PUBLIC_MEDIA_BASE_URL=
# Preferred rotation-safe configuration: JSON object of key ID to base64url 32-byte key.
AGENCY_PUBLIC_MEDIA_SIGNING_KEYS_JSON=
AGENCY_PUBLIC_MEDIA_ACTIVE_SIGNING_KEY_ID=
# Migration-only legacy single key. Do not configure together with the keyring variables.
AGENCY_PUBLIC_MEDIA_SIGNING_KEY=
AGENCY_PUBLIC_MEDIA_TTL_SECONDS=86400

# Optional stable Cloudflare named tunnel. Configure both or neither.
# The token is copied to a private untracked token file before cloudflared starts.
AGENCY_CLOUDFLARE_TUNNEL_TOKEN=
AGENCY_CLOUDFLARE_PUBLIC_URL=

# Optional server-side token bootstrap. Use OAuth instead when possible.
# All configured tokens are encrypted before persistence and are never returned to the browser.
AGENCY_SOCIAL_BOOTSTRAP_TENANT_ID=

AGENCY_X_USER_ACCESS_TOKEN=
AGENCY_X_USER_ACCESS_TOKEN_SECRET=
AGENCY_X_ACCOUNT_ID=
AGENCY_X_ACCOUNT_USERNAME=

AGENCY_INSTAGRAM_ACCESS_TOKEN=
AGENCY_INSTAGRAM_ACCOUNT_ID=
AGENCY_INSTAGRAM_ACCOUNT_USERNAME=
AGENCY_INSTAGRAM_TOKEN_EXPIRES_AT=
# Durable asynchronous station execution.
AGENCY_RUN_WORKER_POLL_INTERVAL_SECONDS=0.35
AGENCY_RUN_LEASE_SECONDS=30
